{
  "name": "wishlist-api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npx nodemon --watch '**/*.ts' --exec ts-node ./src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "husky": "husky init",
    "prepare": "husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:e2e": "jest --selectProjects e2e  --runInBand --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "author": "Vladyslav Smorodskyi",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/express-validator": "^2.20.33",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.6.0",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1",
    "prettier": "^3.6.2"
  }
}
